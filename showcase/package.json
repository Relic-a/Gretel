{
  "name": "gretel-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Recording and rendering pipeline for the Gretel README showcase video.",
  "scripts": {
    "capture": "node capture/recapture.mjs",
    "capture-watch": "node capture/recapture-watch.mjs",
    "prepare-clips": "node scripts/prepare-clips.mjs",
    "normalize": "node capture/normalize.mjs",
    "clips": "node capture/encode-clips.mjs",
    "install-font": "bash scripts/install-font.sh",
    "render": "remotion render src/index.ts GretelShowcase out/gretel-showcase.mp4 --codec h264 --crf 14 --image-format png --audio-bitrate 192k --concurrency 8",
    "narrate": "node --env-file=../.env scripts/narrate.mjs",
    "mix-narration": "node scripts/mix-narration.mjs",
    "mux-narration": "node scripts/mux-narration.mjs",
    "poster": "node scripts/render-poster.mjs",
    "gif": "node scripts/render-gif.mjs",
    "gif-steps": "node scripts/render-step-gifs.mjs",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.409",
    "@remotion/renderer": "4.0.409",
    "playwright": "1.63.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "4.0.409"
  }
}
