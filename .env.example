OPENROUTER_API_KEY=
# OPENROUTER_KEY is also accepted for compatibility with OpenRouter's common naming.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Gretel
GRETEL_LOG_FILE=logs/gretel.log
GRETEL_METRICS_RETENTION_DAYS=30

# Public origin of the marketing site, for canonical URLs and link previews.
# Leave unset for local and desktop builds.
# NEXT_PUBLIC_SITE_URL=https://gretel.example.com
