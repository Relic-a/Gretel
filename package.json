{
  "name": "gretel",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "tauri:build": "tauri build",
    "dist": "tauri build",
    "dist:win": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "dist:linux": "tauri build --target x86_64-unknown-linux-gnu --bundles deb,rpm",
    "dist:mac": "tauri build",
    "generate:icons": "tauri icon logo.png",
    "test": "node tests/updater-config-test.mjs && node tests/updater-manifest-test.mjs && node tests/release-assets-test.mjs && node tests/tauri-config-test.mjs && node tests/youtube-player-error-test.mjs && node tests/autoplay-integration-test.mjs && node tests/logger-test.mjs && node tests/network-retry-test.mjs && node tests/thumbnail-avatar-pipeline-test.mjs && node tests/config-smoke-test.mjs && node tests/feed-algorithm-test.mjs && node tests/channel-search-e2e-test.mjs && node tests/comments-patch-test.mjs",
    "postinstall": "node scripts/patch-dependencies.mjs",
    "start": "next start",
    "lint": "tsc --noEmit"
  },
  "description": "Gretel desktop app",
  "author": "Ezana",
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "better-sqlite3": "^12.9.0",
    "lucide-react": "^1.14.0",
    "next": "16.3.4",
    "pino": "^10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "youtube-transcript": "^1.3.1",
    "youtubei.js": "17.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "onlyBuiltDependencies": [
    "better-sqlite3"
  ],
  "allowScripts": {
    "better-sqlite3@12.9.0": true
  }
}
