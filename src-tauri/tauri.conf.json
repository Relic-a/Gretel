{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gretel",
  "version": "0.4.1",
  "identifier": "com.ezana.gretel",
  "build": {
    "beforeDevCommand": "npm run dev -- --hostname 127.0.0.1 --port 3000",
    "beforeBuildCommand": "npm run tauri:prepare",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gretel",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 700,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0a0a0c",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Curate your YouTube feed",
    "longDescription": "Build a more intentional YouTube feed with profiles, topics, channels, and local history.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.next/standalone": ".next/standalone",
      "../config": "config",
      "node-runtime": "node-runtime"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-plugin-openh264"
        ],
        "recommends": [
          "gstreamer1-plugin-libav"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
